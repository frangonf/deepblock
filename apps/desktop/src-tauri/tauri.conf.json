{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepBlock",
  "version": "0.2.0",
  "identifier": "com.deepblock.desktop",
  "build": {
    "beforeDevCommand": "DEEPBLOCK_DEV_LOCAL=1 mise run dev:web",
    "beforeBuildCommand": "mise run build:web && mise run prepare:bundle",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepBlock",
        "width": 1440,
        "height": 900,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "resources/bin/**/*"
    ],
    "category": "Productivity",
    "shortDescription": "DeepBlock desktop shell",
    "longDescription": "Tauri desktop shell for the Rust DeepBlock rewrite.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libxdo3"
        ],
        "files": {
          "/usr/share/doc/deepblock-desktop/README.md": "../../../docs/linux-development.md",
          "/usr/share/doc/deepblock-desktop/copyright": "../../../LICENSE"
        }
      }
    }
  }
}
