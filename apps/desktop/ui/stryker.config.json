{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "reporters": ["progress", "clear-text", "html", "json"],
  "concurrency": 1,
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 0
  },
  "ignorePatterns": [
    "**/target/**",
    "**/dist/**",
    "**/.playwright-data/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/mutants.out*/**",
    "**/.stryker-tmp*/**",
    "**/proptest-regressions/**",
    "**/target",
    "**/dist",
    "**/.stryker-tmp*",
    "**/mutants.out*"
  ],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/{*.test.ts,*.test.tsx,*.spec.ts,*.spec.tsx,*.d.ts}",
    "!src/setupTests.ts"
  ],
  "incremental": false,
  "htmlReporter": {
    "fileName": "reports/mutation/ui.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/ui.json"
  },
  "disableTypeChecks": "**/*.{ts,tsx}"
}
