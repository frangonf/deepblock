{
  "name": "deepblock-desktop-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=26.1.0 <27",
    "pnpm": ">=11.8.0 <13"
  },
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "node ../../../scripts/dev.ts web",
    "build": "pnpm run build:web",
    "build:web": "tsc -b && vite build",
    "build:tauri:e2e": "pnpm run build:web && cd ../src-tauri && ../ui/node_modules/.bin/tauri build --debug --no-bundle --config '{\"build\":{\"beforeBuildCommand\":\"\"}}'",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "pnpm run preview:web",
    "preview:web": "node ../../../scripts/dev.ts preview",
    "test:e2e": "pnpm run test:web",
    "test:web": "playwright test",
    "test:unit": "vitest run",
    "test:e2e:tauri": "node ./scripts/run-tauri-e2e.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@schedule-x/calendar": "4.9.1",
    "@schedule-x/current-time": "4.9.1",
    "@schedule-x/drag-and-drop": "3.7.3",
    "@schedule-x/events-service": "4.9.1",
    "@schedule-x/react": "4.1.0",
    "@schedule-x/resize": "3.7.3",
    "@schedule-x/theme-default": "4.9.1",
    "@tanstack/react-query": "5.108.1",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-notification": "2.8.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "temporal-polyfill": "0.3.2"
  },
  "devDependencies": {
    "@crabnebula/tauri-driver": "2.0.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fast-check": "4.10.3",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "webdriver": "10.2.0"
  }
}
