{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "reporters": ["progress", "clear-text", "html", "json"],
  "concurrency": 1,
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 0
  },
  "ignorePatterns": [
    "**/target/**",
    "**/dist/**",
    "**/.playwright-data/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/mutants.out*/**",
    "**/.stryker-tmp*/**",
    "**/proptest-regressions/**",
    "**/target",
    "**/dist",
    "**/.stryker-tmp*",
    "**/mutants.out*"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm -C apps/desktop/ui run test:web --max-failures=1"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "apps/desktop/ui/src/**/*.{ts,tsx}",
    "!apps/desktop/ui/src/**/{*.test.ts,*.test.tsx,*.spec.ts,*.spec.tsx,*.d.ts}",
    "!apps/desktop/ui/src/setupTests.ts"
  ],
  "incremental": false,
  "timeoutMS": 180000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 15,
  "htmlReporter": {
    "fileName": "reports/mutation/web.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/web.json"
  },
  "disableTypeChecks": "**/*.{ts,tsx}"
}
